# ============================================
# PostgreSQL Database Credentials
# ============================================
# These values are the single source of truth. They are consumed by:
#   - The Postgres container (POSTGRES_USER/PASSWORD/DB initialize the cluster on first boot)
#   - The Python app (database.py builds the SQLAlchemy URL from these vars)
#
# POSTGRES_HOST: use "localhost" when running the Python app on the host machine
# (e.g. `uvicorn main:app` directly). With `docker compose up`, the backend
# container reaches Postgres via the service name "db" — that value is hard-set
# in docker-compose.yml's `environment:` block, so this var only matters for
# host-side runs and tests.
POSTGRES_USER=scorer_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=malicious_email_scorer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# External APIs
# ============================================
# Obtain a free API key from https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ============================================
# Application Settings
# ============================================
APP_ENV=development
